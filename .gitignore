# ==========================================
# Byte-compiled / Python Cache
# ==========================================
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ==========================================
# Virtual Environments & Env Variables
# ==========================================
.venv/
venv/
env/
ENV/
*.bak/
.env
.env.*
!.env.example

# ==========================================
# Build & Distribution Artifacts (Nuitka / Inno Setup)
# ==========================================
/dist/
/dist_build/
/dist_installer/
*.build/
*.dist/

# ==========================================
# Device-Specific & Sensitive Credentials
# ==========================================
# Ignore personal login session tokens & device-specific configs
settings/auth_session.json
**/auth_session.json
settings/bot_settings_*.json
!settings/bot_settings.json
settings/discord_config.json
settings/*.local.json
src/settings/
**/src/settings/

# ==========================================
# Runtime Screenshots, Logs & History
# ==========================================
screenshots/
**/screenshots/
src/screenshots/
**/src/screenshots/
logs_error/
**/logs_error/
logs/
**/logs/
debug_screens/
**/debug_screens/
scratch/
**/scratch/
history/*.csv
history/*.json
!history/.gitkeep
*.log
*.tmp
*.temp
err.txt
out.txt
*.xml
crash_log.txt
**/crash_log.txt
/macros/*.json

# ==========================================
# Root-level Temporary / Debug Images & Stray Files
# ==========================================
/*.png
/*.jpg
/*.jpeg
/*.bmp
/*.webp
/bot_icon.ico

# ==========================================
# Node / Frontend Build & Caches
# ==========================================
node_modules/
frontend/node_modules/
**/node_modules/
frontend/.vite/
**/.vite/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Operating System & IDE
# ==========================================
Thumbs.db
[Dd]esktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ==========================================
# Agent & Local IDE Metadata
# ==========================================
.gemini/
.agents/
